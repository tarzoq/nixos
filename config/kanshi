output "PNP(AOC) 2460G4 0x000000DC" {
  mode "1920x1080" 
  scale 1
  alias $gamingMain
}
output "LG Electronics LG ULTRAWIDE 0x00021E47" {
  mode "3440x1440@59.973" 
  scale 1
  alias $wideScreen
}

output "eDP-1" {
  #mode "3440x1440@59.973" 
  #scale 1
  alias $laptop
}

output "Philips Consumer Electronics Company PHL 275S9J UK02402010099" {
  mode "2560x1440@74.968" 
  scale 1
  alias $workMain
}
output "Philips Consumer Electronics Company PHL 275S9J UK02402009980" {
  mode "2560x1440@74.968" 
  scale 1
  alias $workSecondary
}

################# PROFILES ####################3
profile desk_temp {
  output $wideScreen position 0,0 enable
  output $laptop position 3440,900 enable
}
profile desk_home {
  output $gamingMain position 0,0 enable
  output $wideScreen position 1920,-150 enable
}
profile docked_work {
  output $workMain position 0,0 enable
  output $workSecondary position 2560,-20 enable
  output $laptop disable 
}


